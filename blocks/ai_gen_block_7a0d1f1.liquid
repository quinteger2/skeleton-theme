          {% endif %}
        </div>
      </div>
    {% endif %}
  </div>
</scroll-timeline-{{ ai_gen_id }}>

<script>
  (function() {
    class ScrollTimeline{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.items = [];
        this.progressBar = null;
        this.timelineContainer = null;
      }

      connectedCallback() {
        this.items = Array.from(this.querySelectorAll('[data-timeline-item]'));
        this.progressBar = this.querySelector('.ai-timeline-progress-{{ ai_gen_id }}');
        this.timelineContainer = this.querySelector('.ai-timeline-container-{{ ai_gen_id }}');
        
        this.handleScroll = this.handleScroll.bind(this);
        window.addEventListener('scroll', this.handleScroll);
        this.handleScroll();
      }

      disconnectedCallback() {
        window.removeEventListener('scroll', this.handleScroll);
      }

      handleScroll() {
        if (!this.timelineContainer || this.items.length === 0) return;

        const containerRect = this.timelineContainer.getBoundingClientRect();
        const windowHeight = window.innerHeight;
        const scrollTrigger = windowHeight * 0.7;

        let activeCount = 0;
        let lastActiveIndex = -1;

        this.items.forEach((item, index) => {
          const itemRect = item.getBoundingClientRect();
          const itemMiddle = itemRect.top + itemRect.height / 2;

          if (itemMiddle < scrollTrigger) {
            item.classList.add('active');
            activeCount++;
            lastActiveIndex = index;
          } else {
            item.classList.remove('active');
          }
        });

        if (this.progressBar && this.items.length > 0) {
          let progressPercent = 0;
          
          if (lastActiveIndex >= 0) {
            const lastActiveItem = this.items[lastActiveIndex];
            const lastActiveRect = lastActiveItem.getBoundingClientRect();
            const containerTop = containerRect.top;
            const itemRelativeTop = lastActiveRect.top - containerTop;
            const containerHeight = containerRect.height;
            
            progressPercent = Math.min(100, Math.max(0, (itemRelativeTop / containerHeight) * 100));
          }
          
          this.progressBar.style.height = progressPercent + '%';
        }
      }
    }

    customElements.define('scroll-timeline-{{ ai_gen_id }}', ScrollTimeline{{ ai_gen_id }});
  })();
</script>

